        "cpa.core.settings": ">=1.0.0"
    },
    "capabilities": [
        "sessions.read",
        "events.emit",
        "ui.notifications"
    ],
    "contributes": {
        "settings": [
            "usage"
        ],
        "action": [
            "user.remainingUsage"
        ]
    }
}
