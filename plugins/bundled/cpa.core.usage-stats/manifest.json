{
    "id": "cpa.core.usage-stats",
    "name": "Usage Statistics",
    "version": "1.0.0",
    "apiVersion": "1.0.0",
    "description": "Core token consumption and skill usage settings section",
    "engines": {
        "cpa": ">=1.0.0"
    },
    "entries": {
        "renderer": "./renderer/index.tsx"
    },
    "activationPriority": 140,
